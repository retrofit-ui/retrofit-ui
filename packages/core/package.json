{
  "name": "@retrofit-ui/core",
  "version": "0.3.0",
  "description": "TypeScript types describing retrofit-ui component specs — the wire-format contract for server-driven UI",
  "keywords": [
    "retrofit-ui",
    "server-driven-ui",
    "sdui",
    "json-schema",
    "types"
  ],
  "license": "MIT",
  "author": {
    "name": "retrofit-ui",
    "url": "https://github.com/retrofit-ui"
  },
  "homepage": "https://retrofitui.dev",
  "bugs": {
    "url": "https://github.com/retrofit-ui/retrofit-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retrofit-ui/retrofit-ui.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema.json": "./schema/retrofit-ui.schema.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm gen:schema && tsup",
    "gen:schema": "node scripts/gen-schema.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
