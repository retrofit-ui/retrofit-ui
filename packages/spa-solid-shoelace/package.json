{
  "name": "@retrofit-ui/spa-solid-shoelace",
  "version": "0.3.0",
  "description": "Prebuilt SolidJS + Shoelace renderer for retrofit-ui — drop into any server as static assets; no frontend build required",
  "keywords": [
    "retrofit-ui",
    "server-driven-ui",
    "sdui",
    "solid-js",
    "shoelace",
    "renderer"
  ],
  "license": "MIT",
  "author": {
    "name": "retrofit-ui",
    "url": "https://github.com/retrofit-ui"
  },
  "homepage": "https://retrofitui.dev",
  "bugs": {
    "url": "https://github.com/retrofit-ui/retrofit-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retrofit-ui/retrofit-ui.git",
    "directory": "packages/spa-solid-shoelace"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./renderer": {
      "types": "./dist/types/renderer.d.ts",
      "import": "./dist/renderer/retrofit-ui.js"
    },
    "./renderer.css": "./dist/renderer/spa-solid-shoelace.css",
    "./components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/components/spec-renderer.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && vite build && vite build --config vite.renderer.config.ts && vite build --config vite.components.config.ts && tsup --config tsup.types.config.ts",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src ui"
  },
  "dependencies": {
    "@retrofit-ui/core": "workspace:^"
  },
  "peerDependencies": {
    "@shoelace-style/shoelace": "^2.20.0",
    "@solidjs/router": ">=0.15.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@shoelace-style/shoelace": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fullcalendar/core": "^6.0.0",
    "@fullcalendar/daygrid": "^6.0.0",
    "@fullcalendar/interaction": "^6.0.0",
    "@fullcalendar/list": "^6.0.0",
    "@fullcalendar/timegrid": "^6.0.0",
    "@shoelace-style/shoelace": "^2.20.0",
    "@solidjs/router": "^0.15.0",
    "@types/node": "^20",
    "dompurify": "^3.4.17",
    "jsdom": "^25.0.1",
    "marked": "^18.0.5",
    "solid-js": "^1.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.8"
  }
}
