{
  "name": "@retrofit-ui/builder-zod",
  "version": "0.0.1",
  "description": "Zod-driven UI spec builders for retrofit-ui (table, form, page, stat, timeline, tree, calendar, workflow)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "peerDependencies": {
    "@retrofit-ui/core": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@retrofit-ui/core": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  }
}
