{
  "name": "@retrofit-ui-examples/custom-view",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx src/server.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@retrofit-ui/core": "workspace:*",
    "@retrofit-ui/spa-solid-shoelace": "workspace:*",
    "@shoelace-style/shoelace": "^2.20.0",
    "@solidjs/router": "^0.15.0",
    "express": "^4",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/express": "^4",
    "@types/node": "^20",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
